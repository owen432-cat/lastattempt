/*==================================================
    Whiskers & Witchcraft
    Style Sheet
==================================================*/

/* Google Fonts */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:wght@400;500;700&family=Poppins:wght@300;400;500;600&display=swap');

/*==================================================
    Variables
==================================================*/

:root{

    --background:#F8F3E8;
    --surface:#FFFDF8;

    --primary:#4C355E;
    --secondary:#7C9A74;
    --accent:#D8B25A;

    --text:#4A3A32;

    --shadow:
    0 15px 35px rgba(0,0,0,.15);

    --radius:20px;

}

/*==================================================
    Reset
==================================================*/

*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}

html{

    scroll-behavior:smooth;

}

body{

    font-family:'Poppins',sans-serif;

    background:var(--background);

    color:var(--text);

    line-height:1.8;

}

img{

    display:block;

    width:100%;

}

section{

    padding:100px 8%;

}

h1,h2,h3{

    font-family:'Cinzel',serif;

    color:var(--primary);

}

p{

    margin-bottom:20px;

}

/*==================================================
Navigation
==================================================*/

nav{

    position:fixed;

    top:0;

    left:0;

    width:100%;

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:18px 8%;

    background:rgba(76,53,94,.92);

    backdrop-filter:blur(12px);

    z-index:1000;

}

.logo{

    color:white;

    font-size:1.3rem;

    font-weight:bold;

    letter-spacing:1px;

}

nav ul{

    display:flex;

    list-style:none;

    gap:30px;

}

nav a{

    color:white;

    text-decoration:none;

    transition:.3s;

    font-weight:500;

}

nav a:hover{

    color:var(--accent);

}

/*==================================================
Hero
==================================================*/

.hero{

    height:100vh;

    background:
    linear-gradient(
    rgba(30,20,40,.55),
    rgba(30,20,40,.65)),
    url("images/hero.jpg");

    background-size:cover;

    background-position:center;

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    position:relative;

}

.hero-overlay{

    position:absolute;

    inset:0;

    background:
    radial-gradient(circle at top right,
    rgba(216,178,90,.15),
    transparent 60%);

}

.hero-content{

    position:relative;

    max-width:850px;

    color:white;

    z-index:2;

}

.hero h1{

    color:white;

    font-size:4.5rem;

    margin-bottom:20px;

}

.hero h2{

    color:#f4f4f4;

    font-family:'Cormorant Garamond',serif;

    font-size:2rem;

    font-weight:500;

    margin-bottom:25px;

}

.quote{

    color:white;

    font-size:1.3rem;

    font-style:italic;

    max-width:750px;

    margin:auto auto 40px;

}

/*==================================================
Button
==================================================*/

.btn{

    display:inline-block;

    padding:16px 40px;

    background:var(--accent);

    color:#222;

    text-decoration:none;

    border-radius:50px;

    font-weight:bold;

    transition:.35s;

}

.btn:hover{

    transform:translateY(-5px);

    box-shadow:

    0 12px 30px rgba(0,0,0,.2);

}

/*==================================================
Section Titles
==================================================*/

.section-title{

    text-align:center;

    margin-bottom:70px;

}

.section-title h2{

    font-size:3rem;

    margin-bottom:20px;

}

.section-title p{

    max-width:800px;

    margin:auto;

    font-size:1.1rem;

}/*==================================================
Meet the Family
==================================================*/

.cat-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

    gap:35px;

}

.cat-card{

    background:var(--surface);

    border-radius:var(--radius);

    overflow:hidden;

    box-shadow:var(--shadow);

    transition:.35s ease;

}

.cat-card:hover{

    transform:translateY(-10px);

    box-shadow:
    0 20px 40px rgba(0,0,0,.18);

}

.cat-card img{

    height:340px;

    object-fit:cover;

}

.card-content{

    padding:30px;

}

.card-content h3{

    margin-bottom:15px;

}

.card-content ul{

    margin-top:20px;

    padding-left:20px;

}

.card-content li{

    margin-bottom:10px;

}

/*==================================================
Gallery
==================================================*/

.gallery{

    background:#F5EFE2;

}

.gallery-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:25px;

}

.gallery-item{

    background:white;

    border-radius:18px;

    overflow:hidden;

    box-shadow:var(--shadow);

    transition:.35s;

}

.gallery-item:hover{

    transform:translateY(-8px);

}

.gallery-item img{

    height:280px;

    object-fit:cover;

    transition:.4s;

}

.gallery-item:hover img{

    transform:scale(1.08);

}

.gallery-item figcaption{

    padding:20px;

}

.gallery-item h3{

    margin-bottom:10px;

    color:var(--primary);

}

/*==================================================
Quote Divider
==================================================*/

.quote-divider{

    background:var(--primary);

    color:white;

    text-align:center;

    padding:70px 10%;

}

.quote-divider blockquote{

    font-size:2rem;

    font-family:'Cormorant Garamond',serif;

    max-width:900px;

    margin:auto;

    font-style:italic;

}

/*==================================================
History Timeline
==================================================*/

.history{

    background:#EFE6D6;

}

.timeline{

    display:grid;

    gap:35px;

}

.timeline-card{

    background:white;

    padding:35px;

    border-left:8px solid var(--accent);

    border-radius:15px;

    box-shadow:var(--shadow);

    transition:.3s;

}

.timeline-card:hover{

    transform:translateX(8px);

}

.timeline-card h3{

    margin-bottom:18px;

}

/*==================================================
Fun Facts
==================================================*/

.facts{

    background:#F8F3E8;

}

.facts-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));

    gap:25px;

}

.fact-card{

    background:white;

    padding:30px;

    text-align:center;

    border-radius:20px;

    box-shadow:var(--shadow);

    transition:.3s;

}

.fact-card:hover{

    transform:translateY(-8px);

}

.fact-card h3{

    margin-bottom:15px;

}

/*==================================================
Love Section
==================================================*/

.love{

    background:#FFFDF8;

}

.love-card{

    max-width:900px;

    margin:auto;

    background:white;

    padding:50px;

    border-radius:25px;

    box-shadow:var(--shadow);

}

.love-card p{

    margin-bottom:25px;

}

.closing{

    text-align:center;

    font-size:2rem;

    color:var(--primary);

    font-family:'Cormorant Garamond',serif;

}

/*==================================================
Footer
==================================================*/

footer{

    background:var(--primary);

    color:white;

    text-align:center;

    padding:70px 20px;

}

footer h3{

    color:white;

    margin-bottom:15px;

}

footer hr{

    width:180px;

    margin:30px auto;

    border:1px solid rgba(255,255,255,.25);

}

footer p{

    margin:12px 0;

}

/*==================================================
Back To Top Button
==================================================*/

#topBtn{

    position:fixed;

    bottom:25px;

    right:25px;

    width:55px;

    height:55px;

    border:none;

    border-radius:50%;

    background:var(--accent);

    color:#222;

    font-size:1.5rem;

    cursor:pointer;

    display:none;

    box-shadow:var(--shadow);

    transition:.3s;

}

#topBtn:hover{

    transform:translateY(-5px);

}

/*==================================================
Scroll Animation
==================================================*/

section{

    opacity:0;

    transform:translateY(40px);

    transition:1s;

}

section.show{

    opacity:1;

    transform:translateY(0);

}

/*==================================================
Responsive
==================================================*/

@media(max-width:1000px){

nav{

    flex-direction:column;

    gap:15px;

}

nav ul{

    flex-wrap:wrap;

    justify-content:center;

}

.hero h1{

    font-size:3.5rem;

}

.hero h2{

    font-size:1.6rem;

}

.section-title h2{

    font-size:2.4rem;

}

}

@media(max-width:768px){

section{

    padding:80px 6%;

}

.hero h1{

    font-size:2.7rem;

}

.hero h2{

    font-size:1.4rem;

}

.quote{

    font-size:1.1rem;

}

.cat-card img{

    height:260px;

}

.gallery-item img{

    height:220px;

}

.love-card{

    padding:35px;

}

.quote-divider blockquote{

    font-size:1.5rem;

}

}

@media(max-width:500px){

.hero h1{

    font-size:2.2rem;

}

.btn{

    padding:14px 30px;

}

.section-title h2{

    font-size:2rem;

}

.logo{

    text-align:center;

}

nav{

    padding:15px;

}

nav ul{

    gap:15px;

}

}